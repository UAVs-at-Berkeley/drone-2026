# Goal: start autonomous payload-drop routine.
# Mission-specific behavior is configured with ROS parameters on payload_drop_node.
bool start

---
# Result
bool success
string message
float64 final_target_latitude_deg
float64 final_target_longitude_deg
float64 release_latitude_deg
float64 release_longitude_deg
float64 final_confidence
bool release_commanded
float64 detected_pixel_x
float64 detected_pixel_y

